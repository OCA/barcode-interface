<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.QuickInfoScreen">
        <div class="ilx-v2-screen">
            <header class="ilx-v2-header">
                <button class="ilx-v2-back-btn" t-on-click="goBack">
                    <i class="fa fa-arrow-left" />
                </button>
                <h1 class="ilx-v2-header-title">Quick Info</h1>
                <div style="width: 48px;" />
            </header>

            <t t-if="state.resultDetails">
                <div class="ilx-v2-main" style="padding: 0;">
                    <div
                        class="ilx-kw-tab-content"
                        style="flex: 1; display: flex; flex-direction: column;"
                    >
                        <div
                            class="ilx-kw-card"
                            style="flex: 1; display: flex; flex-direction: column; gap: 12px;"
                        >
                            <div class="ilx-kw-info-row">
                                <div
                                    class="ilx-kw-icon-box"
                                    t-att-class="state.resultType === 'product' ? 'ilx-kw-bg-orange' : 'ilx-kw-bg-brown'"
                                    style="width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0;"
                                >
                                    <i
                                        t-att-class="'fa ' + (state.resultType === 'product' ? 'fa-archive' : 'fa-map-marker')"
                                    />
                                </div>
                                <div class="ilx-kw-info-text">
                                    <span class="ilx-kw-eyebrow">
                                        <t
                                            t-esc="state.resultType === 'product' ? 'PRODUCT' : 'LOCATION'"
                                        />
                                    </span>
                                    <strong class="ilx-kw-title">
                                        <t
                                            t-esc="state.resultDetails.display_name || state.resultDetails.name"
                                        />
                                    </strong>
                                </div>
                            </div>
                            <t t-if="state.resultType === 'product'">
                                <div class="ilx-kw-info-row mt-3">
                                    <div
                                        class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                    >
                                        <i class="fa fa-barcode" />
                                    </div>
                                    <div class="ilx-kw-info-text">
                                        <span class="ilx-kw-eyebrow">Barcode</span>
                                        <span class="ilx-kw-value">
                                            <t
                                                t-esc="state.resultDetails.barcode || '—'"
                                            />
                                        </span>
                                    </div>
                                </div>
                                <div class="ilx-kw-info-row mt-3">
                                    <div
                                        class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                    >
                                        <i class="fa fa-tag" />
                                    </div>
                                    <div class="ilx-kw-info-text">
                                        <span class="ilx-kw-eyebrow">SKU</span>
                                        <span class="ilx-kw-value">
                                            <t
                                                t-esc="state.resultDetails.default_code || '—'"
                                            />
                                        </span>
                                    </div>
                                </div>
                                <div class="ilx-kw-info-row mt-3">
                                    <div
                                        class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                    >
                                        <i class="fa fa-dollar" />
                                    </div>
                                    <div class="ilx-kw-info-text">
                                        <span
                                            class="ilx-kw-eyebrow"
                                        >Cost / Sale Price</span>
                                        <span class="ilx-kw-value">$<t
                                            t-esc="state.resultDetails.standard_price"
                                        /> / $<t
                                            t-esc="state.resultDetails.list_price"
                                        /></span>
                                    </div>
                                </div>
                                <div class="ilx-kw-info-row mt-3">
                                    <div
                                        class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                    >
                                        <i class="fa fa-cube" />
                                    </div>
                                    <div class="ilx-kw-info-text">
                                        <span
                                            class="ilx-kw-eyebrow"
                                        >Tracking / Type</span>
                                        <span class="ilx-kw-value">
                                            <t
                                            t-set="trackingLabels"
                                            t-value="{'serial': 'By Serial', 'lot': 'By Lots', 'none': 'No Tracking'}"
                                        />
                                            <t
                                            t-set="typeLabel"
                                            t-value="state.resultDetails.is_storable ? 'Storable Product' : (state.resultDetails.type === 'service' ? 'Service' : state.resultDetails.type === 'combo' ? 'Combo' : 'Consumable')"
                                        />
                                            <t
                                            t-esc="trackingLabels[state.resultDetails.tracking] || state.resultDetails.tracking"
                                        /> · <t t-esc="typeLabel" />
                                        </span>
                                    </div>
                                </div>
                                <div class="ilx-kw-info-row mt-3">
                                    <div
                                        class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                    >
                                        <i class="fa fa-cubes" />
                                    </div>
                                    <div class="ilx-kw-info-text">
                                        <span class="ilx-kw-eyebrow">On Hand</span>
                                        <span class="ilx-kw-value">
                                            <t
                                                t-esc="state.resultDetails.qty_available"
                                            />
                                            <t
                                                t-esc="state.resultDetails.uom_id ? state.resultDetails.uom_id[1] : ''"
                                            />
                                        </span>
                                    </div>
                                </div>
                                <t t-if="state.productStock.length">
                                    <div
                                        class="ilx-kw-info-row mt-3"
                                        style="align-items: flex-start;"
                                    >
                                        <div
                                            class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                        >
                                            <i class="fa fa-map-marker" />
                                        </div>
                                        <div class="ilx-kw-info-text" style="flex: 1;">
                                            <span
                                                class="ilx-kw-eyebrow"
                                            >Stock by Location (<t
                                                t-esc="state.productStock.length"
                                            />)</span>
                                            <div style="margin-top: 4px;">
                                                <t
                                                    t-foreach="state.productStock"
                                                    t-as="item"
                                                    t-key="item.locationId"
                                                >
                                                    <div class="ilx-kw-stock-row">
                                                        <span
                                                            class="ilx-kw-stock-row__name"
                                                        >
                                                            <t
                                                                t-esc="item.locationName"
                                                            />
                                                        </span>
                                                        <span
                                                            class="ilx-kw-stock-row__qty"
                                                        >
                                                            <t t-esc="item.quantity" />
                                                        </span>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.lot">
                                    <div
                                        class="ilx-kw-info-row mt-3"
                                        style="align-items: flex-start;"
                                    >
                                        <div
                                            class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                        >
                                            <i class="fa fa-tags" />
                                        </div>
                                        <div class="ilx-kw-info-text" style="flex: 1;">
                                            <span
                                                class="ilx-kw-eyebrow"
                                            >Scanned Lot / Serial</span>
                                            <span class="ilx-kw-value">
                                                <t t-esc="state.lot.name" />
                                            </span>
                                            <t t-if="state.lotStock.length">
                                                <div style="margin-top: 4px;">
                                                    <t
                                                        t-foreach="state.lotStock"
                                                        t-as="item"
                                                        t-key="item.locationId"
                                                    >
                                                        <div class="ilx-kw-stock-row">
                                                            <span
                                                                class="ilx-kw-stock-row__name"
                                                            >
                                                                <t
                                                                    t-esc="item.locationName"
                                                                />
                                                            </span>
                                                            <span
                                                                class="ilx-kw-stock-row__qty"
                                                            >
                                                                <t
                                                                    t-esc="item.quantity"
                                                                />
                                                            </span>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <span
                                                    class="ilx-kw-value"
                                                    style="font-size: 0.85rem;"
                                                >No stock on hand for this lot</span>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-if="state.resultType === 'location'">
                                <div class="ilx-kw-info-row mt-3">
                                    <div
                                        class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                    >
                                        <i class="fa fa-barcode" />
                                    </div>
                                    <div class="ilx-kw-info-text">
                                        <span class="ilx-kw-eyebrow">Barcode</span>
                                        <span class="ilx-kw-value">
                                            <t
                                                t-esc="state.resultDetails.barcode || '—'"
                                            />
                                        </span>
                                    </div>
                                </div>
                                <div class="ilx-kw-info-row mt-3">
                                    <div
                                        class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                    >
                                        <i class="fa fa-flag" />
                                    </div>
                                    <div class="ilx-kw-info-text">
                                        <span class="ilx-kw-eyebrow">Usage</span>
                                        <span class="ilx-kw-value">
                                            <t
                                                t-set="usageLabels"
                                                t-value="{'customer': 'Customer', 'internal': 'Internal', 'supplier': 'Vendor', 'transit': 'Transit', 'view': 'View', 'inventory': 'Inventory Adjustment', 'production': 'Manufacturing', 'loss': 'Inventory Loss'}"
                                            />
                                            <t
                                                t-esc="usageLabels[state.resultDetails.usage] || state.resultDetails.usage"
                                            />
                                        </span>
                                    </div>
                                </div>
                                <t t-if="state.locationStock.length">
                                    <div
                                        class="ilx-kw-info-row mt-3"
                                        style="align-items: flex-start;"
                                    >
                                        <div
                                            class="ilx-kw-icon-box-small ilx-kw-bg-purple-light"
                                        >
                                            <i class="fa fa-cubes" />
                                        </div>
                                        <div class="ilx-kw-info-text" style="flex: 1;">
                                            <span
                                                class="ilx-kw-eyebrow"
                                            >Current Stock (<t
                                                t-esc="state.locationStock.length"
                                            />)</span>
                                            <div style="margin-top: 4px;">
                                                <t
                                                    t-foreach="paginatedStock"
                                                    t-as="item"
                                                    t-key="item.productId"
                                                >
                                                    <div class="ilx-kw-stock-row">
                                                        <span
                                                            class="ilx-kw-stock-row__name"
                                                        >
                                                            <t
                                                                t-esc="item.productName"
                                                            />
                                                        </span>
                                                        <span
                                                            class="ilx-kw-stock-row__qty"
                                                        >
                                                            <t t-esc="item.quantity" />
                                                        </span>
                                                    </div>
                                                </t>
                                            </div>
                                            <t t-if="stockTotalPages > 1">
                                                <div
                                                    style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;"
                                                >
                                                    <button
                                                        class="btn btn-sm btn-secondary"
                                                        t-on-click="prevStockPage"
                                                        t-att-disabled="state.stockPage === 0"
                                                    >
                                                        <i class="fa fa-chevron-left" />
                                                    </button>
                                                    <span
                                                        style="font-size: 0.8rem; color: #666;"
                                                    ><t
                                                        t-esc="state.stockPage + 1"
                                                    /> / <t
                                                        t-esc="stockTotalPages"
                                                    /></span>
                                                    <button
                                                        class="btn btn-sm btn-secondary"
                                                        t-on-click="nextStockPage"
                                                        t-att-disabled="state.stockPage >= stockTotalPages - 1"
                                                    >
                                                        <i
                                                            class="fa fa-chevron-right"
                                                        />
                                                    </button>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="ilx-v2-main ilx-qi-v2-scan-view">
                    <h2 class="ilx-qi-v2-scan-title">Quick Information</h2>
                    <p
                        class="ilx-qi-v2-scan-subtitle"
                    >Scan a product or location barcode</p>

                    <div class="ilx-qi-v2-cards" style="width: 100%;">
                        <div
                            class="ilx-qi-v2-card"
                            t-on-click="openProductSelector"
                            style="align-items: center; text-align: center;"
                        >
                            <div
                                class="ilx-qi-v2-card-icon"
                                style="background: #6A4C73; color: white; width: 64px; height: 64px; border-radius: 16px; margin-bottom: 0.5rem; position: relative; z-index: 2;"
                            >
                                <i class="fa fa-archive" />
                            </div>
                            <i
                                class="fa fa-archive"
                                style="position: absolute; right: 1rem; top: 1rem; font-size: 5rem; color: #f4f4f4; z-index: 1;"
                            />
                            <h3
                                style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #51275E; position: relative; z-index: 2;"
                            >Product</h3>
                        </div>
                        <div
                            class="ilx-qi-v2-card"
                            t-on-click="openLocationSelector"
                            style="align-items: center; text-align: center;"
                        >
                            <div
                                class="ilx-qi-v2-card-icon"
                                style="background: #8D6E2E; color: white; width: 64px; height: 64px; border-radius: 16px; margin-bottom: 0.5rem; position: relative; z-index: 2;"
                            >
                                <i class="fa fa-map-marker" />
                            </div>
                            <i
                                class="fa fa-map-marker"
                                style="position: absolute; right: 1rem; top: 1rem; font-size: 5rem; color: #f4f4f4; z-index: 1;"
                            />
                            <h3
                                style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #8D6E2E; position: relative; z-index: 2;"
                            >Location</h3>
                        </div>
                        <div
                            class="ilx-qi-v2-card"
                            style="align-items: center; text-align: center; cursor: default;"
                        >
                            <div
                                class="ilx-qi-v2-card-icon"
                                style="background: #2E7D32; color: white; width: 64px; height: 64px; border-radius: 16px; margin-bottom: 0.5rem; position: relative; z-index: 2;"
                            >
                                <i class="fa fa-barcode" />
                            </div>
                            <i
                                class="fa fa-barcode"
                                style="position: absolute; right: 1rem; top: 1rem; font-size: 5rem; color: #f4f4f4; z-index: 1;"
                            />
                            <h3
                                style="margin: 0 0 0.75rem 0; font-size: 1.25rem; font-weight: 800; color: #2E7D32; position: relative; z-index: 2;"
                            >Manual Barcode</h3>
                            <input
                                class="ilx-qi-v2-gs1-input"
                                placeholder="Enter barcode"
                                t-model="state.barcode"
                                t-on-keydown="onInputKeydown"
                                data-enable-barcode="true"
                                style="position: relative; z-index: 2;"
                            />
                            <button
                                class="ilx-qi-v2-barcode-btn"
                                t-on-click="searchBarcode"
                                style="position: relative; z-index: 2;"
                            >
                                <i class="fa fa-search me-2" /> Search Barcode
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
