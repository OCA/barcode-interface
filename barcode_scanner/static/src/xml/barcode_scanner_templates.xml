<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.App">
        <div class="barcode-app-root">
            <t t-if="this.currentScreen">
                <t
                    t-component="this.currentScreen.component"
                    t-props="this.currentScreenProps"
                />
            </t>
            <div
                t-if="this.feedback.flash.active"
                t-att-class="`barcode-feedback-flash barcode-feedback-flash--${this.feedback.flash.level}`"
                t-att-data-token="this.feedback.flash.token"
            />
            <t t-foreach="this.appWidgets" t-as="widget" t-key="widget_index">
                <t t-component="widget.component" />
            </t>
        </div>
    </t>

    <t t-name="barcode_scanner.MainScreen">
        <div class="ilx-home-screen">
            <header class="ilx-home-header">
                <div class="ilx-home-top-bar">
                    <button class="ilx-home-menu-btn" t-on-click="this.goHome">
                        <i class="oi" data-icon="grid_view" />
                    </button>
                    <div class="ilx-home-avatar">
                        <img
                            t-if="this.showAvatarImage"
                            class="ilx-home-avatar-img"
                            t-att-src="this.avatarUrl"
                            t-on-error="this.onAvatarError"
                            alt="Avatar"
                        />
                        <span t-else="" class="ilx-home-avatar-text">
                            <t t-out="this.userInitials" />
                        </span>
                    </div>
                </div>

                <h3 class="ilx-home-title">
                    <t t-out="this.greeting" />,<br />
                    <span class="ilx-home-title-name"><t
                    t-out="this.userName"
                />.</span>
                </h3>
                <p
                    class="ilx-home-subtitle"
                >Ready for today's distribution schedule.</p>
            </header>

            <main class="ilx-home-main">
                <div class="ilx-home-grid">
                    <t t-foreach="this.menuTiles" t-as="tile" t-key="tile.id">
                        <button
                            class="ilx-home-grid-item"
                            t-on-click="() => this.onTileClick(tile)"
                        >
                            <div t-att-class="'ilx-home-grid-icon ' + tile.iconClass">
                                <i class="oi" t-att-data-icon="tile.icon" />
                            </div>
                            <span class="ilx-home-grid-title" t-out="tile.label" />
                        </button>
                    </t>
                </div>
            </main>
        </div>
    </t>
</templates>
